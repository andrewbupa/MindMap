    "/api/system/checks/{check_id}/events": {
      "get": {
        "description": "Status updates as server-sent events. Clients reconnect, or fall back to polling.",
        "operationId": "stream_check",
        "parameters": [
          {
            "in": "path",
            "name": "check_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Check Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "properties": {
                    "data": {
                      "type": "string"
                    },
                    "event": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "retry": {
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Stream Check",
        "tags": [
          "system"
        ]
      }
    },
    "/api/system/checks/{check_id}/object": {
      "get": {
        "description": "A short-lived link to the object the worker wrote: the evidence behind the check.",
        "operationId": "check_object",
        "parameters": [
          {
            "in": "path",
            "name": "check_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Check Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedUrlOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Check Object",
        "tags": [
          "system"
        ]
      }
    },
