            },
            "description": "Successful Response"
          }
        },
        "summary": "Launch Check",
        "tags": [
          "system"
        ]
      }
    },
    "/api/system/checks/{check_id}": {
      "get": {
        "operationId": "read_check",
        "parameters": [
          {
            "in": "path",
            "name": "check_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Check Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
