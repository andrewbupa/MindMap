# Copy to .env for local development. .env is ignored by git; never commit secrets.
BENCH_ENVIRONMENT=local
BENCH_PUBLIC_URL=http://localhost:3000
BENCH_DATABASE_URL=postgresql://bench:bench@localhost:5432/bench

# Any S3-compatible server stands in for Spaces locally, such as `moto_server -p 9000`
# from the dev dependencies. docker-compose runs SeaweedFS instead.
BENCH_SPACES_ENDPOINT=http://localhost:9000
BENCH_SPACES_REGION=syd1
BENCH_SPACES_BUCKET=bench-logs
BENCH_SPACES_KEY=bench
BENCH_SPACES_SECRET=bench-secret

# The mock identity provider from docker-compose. Its sign-in form lets you
# choose any username; put {"email": "you@example.test", "name": "You"} in claims.
BENCH_OIDC_METADATA_URL=http://localhost:8080/bench/.well-known/openid-configuration
BENCH_OIDC_CLIENT_ID=bench-local
BENCH_OIDC_CLIENT_SECRET=bench-local-secret
BENCH_BOOTSTRAP_ADMINS=admin@example.test
BENCH_SESSION_SECRET=local-only-session-secret-change-me

# Used by the web app's server components.
BENCH_API_INTERNAL_URL=http://localhost:8000
