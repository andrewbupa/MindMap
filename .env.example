# Copy to .env for local development. .env is ignored by git; never commit secrets.
AGORA_ENVIRONMENT=local
AGORA_PUBLIC_URL=http://localhost:3000
AGORA_DATABASE_URL=postgresql://agora:agora@localhost:5432/agora

# Files (Inspect logs, raw judge answers) are kept in Postgres. To use Spaces or
# another S3-compatible store instead, set AGORA_STORAGE=spaces and the
# AGORA_SPACES_* settings (see python/core/agora_core/config.py).

# The mock identity provider from docker-compose. Its sign-in form lets you
# choose any username; put {"email": "you@example.test", "name": "You"} in claims.
AGORA_OIDC_METADATA_URL=http://localhost:8080/agora/.well-known/openid-configuration
AGORA_OIDC_CLIENT_ID=agora-local
AGORA_OIDC_CLIENT_SECRET=agora-local-secret
AGORA_BOOTSTRAP_ADMINS=admin@example.test
AGORA_SESSION_SECRET=local-only-session-secret-change-me

# Used by the web app's server components.
AGORA_API_INTERNAL_URL=http://localhost:8000

# Models: the development model needs no key. For real models, remove this line
# and set ANTHROPIC_API_KEY.
AGORA_MODELS_FILE=config/models.dev.yaml

# Open-model witness: the development reader needs no GPU. Production readers run
# on the Droplet runner (infra/runner).
AGORA_WITNESS_FILE=config/witness.dev.yaml
